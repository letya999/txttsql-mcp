{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.letya999/txttsql-mcp",
  "title": "txttsql-mcp",
  "description": "Read-only analytics MCP for PostgreSQL, CockroachDB and ClickHouse with installable plugins.",
  "websiteUrl": "https://github.com/letya999/txttsql-mcp",
  "repository": {
    "url": "https://github.com/letya999/txttsql-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "cargo",
      "registryBaseUrl": "https://crates.io",
      "identifier": "txttsql-mcp",
      "version": "0.1.0",
      "transport": { "type": "stdio" },
      "packageArguments": [
        {
          "type": "named",
          "name": "--config",
          "valueHint": "config_path",
          "description": "Absolute path to a trusted TOML configuration file",
          "isRequired": true
        }
      ]
    }
  ]
}
